</style>

<script>
  // Fork diagram interaction
  const forkBranches = document.querySelectorAll('.fork-branch');
  forkBranches.forEach((branch) => {
    branch.addEventListener('click', () => {
      forkBranches.forEach((b) => b.classList.remove('selected'));
      branch.classList.add('selected');
    });
  });

  // Diagnostic interaction
  const answers: Record<string, string> = {};
  const diagnosticQuestions = document.querySelectorAll('.dq');
  const resultIds = ['result-agent', 'result-automation', 'result-mostly-automation', 'result-middle'];

  diagnosticQuestions.forEach((dq) => {
    const questionNum = (dq as HTMLElement).dataset.question!;
    const buttons = dq.querySelectorAll('.dq-btn');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const answer = (btn as HTMLElement).dataset.answer!;
        answers[questionNum] = answer;

        buttons.forEach((b) => {
          b.classList.remove('selected', 'selected-no');
        });

        if (answer === 'yes') {
          btn.classList.add('selected');
          dq.classList.remove('answered-no');
          dq.classList.add('answered-yes');
        } else {
          btn.classList.add('selected-no');
          dq.classList.remove('answered-yes');
          dq.classList.add('answered-no');
        }

        if (Object.keys(answers).length === 3) {
          showResult();
        }
      });
    });
  });

  function showResult() {
    const yesCount = Object.values(answers).filter((a) => a === 'yes').length;

    resultIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.hidden = true;
    });

    let targetId: string;
    let targetTab: string;

    if (yesCount === 3) {
      targetId = 'result-agent';
      targetTab = 'agent';
    } else if (yesCount === 0) {
      targetId = 'result-automation';
      targetTab = 'automation';
    } else if (yesCount === 1) {
      targetId = 'result-mostly-automation';
      targetTab = 'automation';
    } else {
      targetId = 'result-middle';
      targetTab = 'agent';
    }

    const target = document.getElementById(targetId);
    if (target) {
      target.hidden = false;
      target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    activateTab(targetTab);
  }

  // Tips tabs
  const tipsTabs = document.querySelectorAll('.tips-tab');
  const tipsPanels = document.querySelectorAll('.tips-panel');

  function activateTab(tab: string) {
    tipsTabs.forEach((t) => {
      t.classList.toggle('active', (t as HTMLElement).dataset.tab === tab);
    });
    tipsPanels.forEach((p) => {
      p.classList.toggle('active', p.id === `panel-${tab}`);
    });
  }

  tipsTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      activateTab((tab as HTMLElement).dataset.tab!);
    });
  });
</script>
