---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Agent Literacy — Practical thinking about humans and AI agents" description="Frameworks, observations, and honest thinking about how humans and AI agents actually work together.">
  <div class="page">
    <header class="hero">
      <h1 class="hero-title">Practical thinking about<br>humans and AI agents</h1>
      <p class="hero-subtitle">Frameworks, observations, and honest distinctions for people figuring out how to work with AI, not just talk about it.</p>
      <div class="hero-line"></div>
    </header>

    <section class="featured">
      <div class="featured-label">Latest</div>
      <a href="/not-sharing-my-setup" class="featured-card">
        <div class="featured-content">
          <span class="featured-tag"><span class="draft-pill">Draft</span> Article</span>
          <h2 class="featured-title">I'm Not Going to Share My Claude Code Setup With You</h2>
          <p class="featured-desc">11,000 prompts, 21 custom skills, 57 merged PRs. People keep asking for my config. Here's why I won't share it, and what I'll share instead.</p>
          <span class="featured-meta">AP · May 20, 2026</span>
        </div>
        <span class="featured-arrow">&rarr;</span>
      </a>

      <a href="/most-agents-arent" class="featured-card">
        <div class="featured-content">
          <span class="featured-tag">Article</span>
          <h2 class="featured-title">Most "AI Agents" Aren't</h2>
          <p class="featured-desc">And that's fine. But knowing which one you're building changes how you should build it. Includes an interactive diagnostic and practical tips for both automations and agents.</p>
          <span class="featured-meta">AP · May 11, 2026</span>
        </div>
        <span class="featured-arrow">&rarr;</span>
      </a>
    </section>

  </div>
</BaseLayout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Hero */
  .hero {
    padding: 12vh 0 64px;
  }

  .hero-title {
    font-size: 40px;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
  }

  .hero-subtitle {
    font-size: 16px;
    font-weight: 300;
    color: var(--color-text-dim);
    line-height: 1.7;
    max-width: 480px;
  }

  .hero-line {
    width: 48px;
    height: 1px;
    background: var(--color-accent);
    margin-top: 40px;
    opacity: 0.5;
  }

  /* Featured */
  .featured {
    flex: 1;
  }

  .featured-label {
    font: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .featured-card + .featured-card {
    margin-top: 16px;
  }

  .featured-card {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
  }

  .featured-card:hover {
    border-color: var(--color-border-hover);
    background: var(--color-surface-hover);
    transform: translateY(-2px);
  }

  .featured-content {
    flex: 1;
  }

  .featured-tag {
    font: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    display: block;
    margin-bottom: 14px;
  }

  .draft-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #18181b;
    background: #fbbf24;
    border-radius: 4px;
    padding: 2px 8px;
    margin-right: 6px;
    vertical-align: 1px;
  }

  .featured-title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.3px;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .featured-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--color-text-dim);
    line-height: 1.7;
    margin-bottom: 16px;
    max-width: 520px;
  }

  .featured-meta {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .featured-arrow {
    font-size: 20px;
    color: var(--color-text-muted);
    padding-top: 8px;
    padding-left: 24px;
    transition: color var(--transition-fast);
  }

  .featured-card:hover .featured-arrow {
    color: var(--color-accent);
  }

  /* Mobile */
  @media (max-width: 600px) {
    .hero {
      padding: 8vh 0 48px;
    }

    .hero-title {
      font-size: 30px;
    }

    .featured-card {
      padding: 24px;
    }

    .featured-arrow {
      display: none;
    }
  }
</style>
