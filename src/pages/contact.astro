---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Agent Literacy">
  <article class="page-content">
    <h1>Get in touch</h1>
    <div class="prose">
      <p>Reach out at <a id="contact-link" class="contact-placeholder">loading...</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .page-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 6vh 24px 100px;
  }

  h1 {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin-bottom: 32px;
  }

  .prose {
    font: var(--font-body);
    color: var(--color-text-secondary);
  }

  .prose p {
    margin-bottom: 20px;
    line-height: 1.8;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--color-text);
  }

  .contact-placeholder {
    color: var(--color-text-muted);
    cursor: default;
  }

  @media (max-width: 600px) {
    .page-content { padding: 4vh 20px 80px; }
    h1 { font-size: 24px; }
  }
</style>

<script>
  const link = document.getElementById('contact-link') as HTMLAnchorElement;
  const parts = ['akshar', 'airtable', 'com'];
  const addr = `${parts[0]}@${parts[1]}.${parts[2]}`;
  link.href = `mailto:${addr}`;
  link.textContent = addr;
  link.classList.remove('contact-placeholder');
</script>
