---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Agent Literacy">
  <nav class="site-nav">
    <a href="/" class="wordmark">Agent Literacy</a>
    <div class="nav-links">
      <a href="/about" class="nav-link">About</a>
      <a href="/contact" class="nav-link active">Contact</a>
    </div>
  </nav>

  <article class="page-content">
    <h1>Get in touch</h1>
    <div class="prose">
      <p>Reach out at <a id="contact-link" class="contact-placeholder">loading...</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px;
    max-width: 720px;
    margin: 0 auto;
  }

  .wordmark {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-size: 13px;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .page-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 6vh 24px 100px;
  }

  h1 {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin-bottom: 32px;
  }

  .prose {
    font: var(--font-body);
    color: var(--color-text-secondary);
  }

  .prose p {
    margin-bottom: 20px;
    line-height: 1.8;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--color-text);
  }

  .contact-placeholder {
    color: var(--color-text-muted);
    cursor: default;
  }
</style>

<script>
  const link = document.getElementById('contact-link') as HTMLAnchorElement;
  const parts = ['akshar', 'airtable', 'com'];
  const addr = `${parts[0]}@${parts[1]}.${parts[2]}`;
  link.href = `mailto:${addr}`;
  link.textContent = addr;
  link.classList.remove('contact-placeholder');
</script>
