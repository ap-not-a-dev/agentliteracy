---
interface Props {
  title: string;
  description: string;
  type: string;
  date: Date;
  readTime: string;
}

const { title, description, type, date, readTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="content-page">
  <a href="/resources" class="back-link">&larr; Back to resources</a>
  <header>
    <span class="type-tag">{type}</span>
    <h1>{title}</h1>
    <div class="meta">{formattedDate} &middot; {readTime}</div>
  </header>
  <div class="prose">
    <slot />
  </div>
</article>

<style>
  .content-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 8vh 24px 80px;
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 48px;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-text-dim);
  }

  header {
    margin-bottom: 48px;
  }

  .type-tag {
    font: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-accent);
    display: block;
    margin-bottom: 16px;
  }

  h1 {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }

  .meta {
    font: var(--font-meta);
    color: var(--color-text-muted);
  }

  .prose {
    font: var(--font-body);
    color: var(--color-text-secondary);
  }

  .prose :global(h2) {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .prose :global(h3) {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .prose :global(p) {
    margin-bottom: 20px;
    line-height: 1.8;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--color-text);
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--color-text-dim);
    font-style: italic;
  }

  .prose :global(code) {
    background: var(--color-input-bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-text);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 22px;
    }
  }
</style>
