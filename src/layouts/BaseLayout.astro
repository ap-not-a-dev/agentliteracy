---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Practical resources for the human side of human-agent collaboration.' } = Astro.props;
const pathname = Astro.url.pathname;
const isAbout = pathname.startsWith('/about');
const isContact = pathname.startsWith('/contact');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="construction-banner">
      <span class="banner-text">Site Under Construction</span>
    </div>
    <nav class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="wordmark">Agent Literacy</a>
        <div class="nav-links">
          <a href="/about" class={`nav-link${isAbout ? ' active' : ''}`}>About</a>
          <a href="/contact" class={`nav-link${isContact ? ' active' : ''}`}>Contact</a>
        </div>
      </div>
    </nav>
  </header>
  <main class="site-main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="disclaimer">This is a personal project. All views expressed here are my own and do not represent the views of my employer.</div>
      <span class="footer-wordmark">&copy; 2026 Akshar Patel</span>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
