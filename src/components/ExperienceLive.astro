<section id="phase-live" class="phase" data-phase="live" style="display:none;">
  <div class="conversation" id="conversation"></div>
</section>

<template id="tpl-user-msg">
  <div class="msg msg-user"></div>
</template>

<template id="tpl-agent-msg">
  <div class="msg msg-agent">
    <div class="agent-label">Agent</div>
    <div class="agent-text"></div>
  </div>
</template>

<template id="tpl-typing">
  <div class="msg msg-agent">
    <div class="typing-indicator">
      <span></span><span></span><span></span>
    </div>
  </div>
</template>

<template id="tpl-follow-up">
  <div class="msg msg-follow-up">
    <div class="follow-up-options"></div>
  </div>
</template>

<template id="tpl-tools">
  <div class="msg msg-tools">
    <div class="tools-label">Connected via MCP</div>
    <div class="tools-row"></div>
    <div class="tools-footnote">MCP is the open protocol that lets agents use your tools.</div>
  </div>
</template>

<style is:global>
  #phase-live {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12vh 24px 40px;
    max-width: 640px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }

  #phase-live.active {
    opacity: 1;
    transform: translateY(0);
  }

  #phase-live.exit {
    opacity: 0;
    transform: translateY(-30px);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .conversation {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .msg {
    opacity: 0;
    transform: translateY(12px);
    transition: all 0.5s ease;
    max-width: 90%;
  }

  .msg.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .msg-user {
    align-self: flex-end;
    background: var(--color-input-focus-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px 16px 4px 16px;
    padding: 14px 18px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .msg-agent {
    align-self: flex-start;
  }

  .agent-label {
    font: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .agent-text {
    font: var(--font-body);
    color: #e2e8f0;
  }

  .typing-indicator {
    display: flex;
    gap: 5px;
    padding: 8px 0;
  }

  .typing-indicator span {
    width: 6px;
    height: 6px;
    background: var(--color-text-muted);
    border-radius: 50%;
    animation: typing 1.4s infinite;
  }

  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing {
    0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
  }

  .msg-follow-up {
    align-self: stretch;
    max-width: 100%;
  }

  .follow-up-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .follow-up-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px 20px;
    color: #cbd5e1;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .follow-up-btn:hover {
    background: rgba(129, 140, 248, 0.08);
    border-color: rgba(129, 140, 248, 0.3);
    color: #ffffff;
    transform: translateX(4px);
  }

  .follow-up-btn .btn-indicator {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(129, 140, 248, 0.1);
    border: 1px solid rgba(129, 140, 248, 0.15);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #818cf8;
  }

  .follow-up-btn:hover .btn-indicator {
    background: rgba(129, 140, 248, 0.2);
    border-color: rgba(129, 140, 248, 0.3);
  }

  .follow-up-btn .btn-text {
    flex: 1;
  }

  .msg-tools {
    align-self: flex-start;
    max-width: 100%;
  }

  .tools-label {
    font: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .tools-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .tool-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .tool-badge .tool-icon {
    width: 18px;
    height: 18px;
    opacity: 0.85;
    filter: brightness(0) invert(1);
  }

  .tools-footnote {
    font-size: 11px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .msg-closer {
    align-self: flex-start;
    width: 100%;
  }

  .closer-intro {
    font: 300 15px/1.7 'Inter', -apple-system, sans-serif;
    color: #e2e8f0;
    margin-bottom: 20px;
  }

  .closer-steps {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }

  .closer-step {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .closer-step-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(129, 140, 248, 0.1);
    border: 1px solid rgba(129, 140, 248, 0.12);
    border-radius: 8px;
  }

  .closer-step-icon img {
    width: 15px;
    height: 15px;
    opacity: 0.85;
    filter: brightness(0) invert(1);
  }

  .closer-step-body {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }

  .closer-step-tool {
    font-size: 11px;
    font-weight: 600;
    color: #818cf8;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .closer-step-text {
    font-size: 13px;
    line-height: 1.4;
    color: #94a3b8;
  }

  .closer-outro {
    font: 300 15px/1.7 'Inter', -apple-system, sans-serif;
    color: #ffffff;
    font-weight: 400;
  }

  .closer-mcp {
    margin-top: 16px;
    font-size: 11px;
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .phase {
      padding-top: 8vh;
    }
    .follow-up-btn {
      max-width: 280px;
    }
  }
</style>

<script>
  interface CloserStep {
    text: string;
    tool?: { icon: string; name: string };
  }

  interface ScenarioData {
    agentOpener: string;
    followUps: string[];
    closerIntro: string;
    closerSteps: CloserStep[];
    closerOutro: string;
  }

  const SCENARIOS: Record<string, ScenarioData> = {
    standup: {
      agentOpener: "Let's think about this. Right now, who's doing the work of pulling updates from everyone, figuring out what's stuck, and making sure the right people hear about it?",
      followUps: [
        "I am \u2014 it takes me an hour every week",
        "We have a meeting, but half the time it's unfocused",
        "Nobody, honestly \u2014 things just fall through the cracks"
      ],
      closerIntro: "Here's what I'll do.",
      closerSteps: [
        { text: "Every Monday, message your team and collect what they shipped, what's blocked, and what's next", tool: { icon: "/icons/slack.svg", name: "Slack" } },
        { text: "Check the week ahead for conflicts or meetings that need prep", tool: { icon: "/icons/google-calendar.svg", name: "Calendar" } },
        { text: "Pull open tasks and flag anything slipping from last week", tool: { icon: "/icons/linear.svg", name: "Linear" } },
        { text: "Chase down anyone who hasn't responded by end of day", tool: { icon: "/icons/email.svg", name: "Email" } }
      ],
      closerOutro: "By the time you open your laptop, you'll have a summary that tells you exactly where to focus."
    },
    website: {
      agentOpener: "When something breaks on your site \u2014 or when you need to publish something new \u2014 what does that process look like right now?",
      followUps: [
        "I do it myself, and it always takes longer than it should",
        "I ask a developer, and it sits in their queue",
        "Things stay broken longer than I'd like to admit"
      ],
      closerIntro: "Here's what I'll do.",
      closerSteps: [
        { text: "Watch your site around the clock for downtime, broken links, and slow pages", tool: { icon: "/icons/cloudflare.svg", name: "Cloudflare" } },
        { text: "When you hand me new content, I'll format it, deploy it, and verify it looks right", tool: { icon: "/icons/github.svg", name: "GitHub" } },
        { text: "Track visitor behavior and surface what's working and what isn't", tool: { icon: "/icons/google-analytics.svg", name: "Analytics" } },
        { text: "If something breaks overnight, fix it and let you know in the morning", tool: { icon: "/icons/slack.svg", name: "Slack" } }
      ],
      closerOutro: "You'll get a weekly digest of what changed, what I caught, and what needs your decision."
    },
    questions: {
      agentOpener: "Think about the last ten questions that came in. How many of them were genuinely unique, and how many were variations of the same few themes?",
      followUps: [
        "Mostly the same questions, different people asking",
        "A mix \u2014 some repetitive, some that actually need me",
        "I'm not sure, they all blend together"
      ],
      closerIntro: "Here's what I'll do.",
      closerSteps: [
        { text: "Ingest your docs, FAQs, and every edge case you've answered before", tool: { icon: "/icons/notion.svg", name: "Notion" } },
        { text: "Answer email questions in minutes, in your voice and tone", tool: { icon: "/icons/email.svg", name: "Email" } },
        { text: "Do the same for questions in Slack \u2014 fast, accurate, on-brand", tool: { icon: "/icons/slack.svg", name: "Slack" } },
        { text: "When something needs your judgment, flag it with full context so you can reply fast", tool: { icon: "/icons/crm.svg", name: "CRM" } }
      ],
      closerOutro: "You'll go from answering every question to only answering the interesting ones."
    },
    market: {
      agentOpener: "How do you stay on top of what's happening in your space right now? News, competitors, trends \u2014 where does that information come from?",
      followUps: [
        "I browse Twitter and newsletters when I have time",
        "My team shares things in Slack, but it's scattered",
        "I mostly hear about things after they've already happened"
      ],
      closerIntro: "Here's what I'll do.",
      closerSteps: [
        { text: "Continuously scan industry news, publications, and analyst reports", tool: { icon: "/icons/news.svg", name: "News" } },
        { text: "Track your competitors and the key voices shaping your space", tool: { icon: "/icons/x.svg", name: "Twitter/X" } },
        { text: "Watch for market signals like hiring patterns and partnership moves", tool: { icon: "/icons/linkedin.svg", name: "LinkedIn" } },
        { text: "Every morning, post a brief to your team with what changed and what it means", tool: { icon: "/icons/slack.svg", name: "Slack" } }
      ],
      closerOutro: "Over time, I'll learn what you actually care about and filter harder."
    }
  };

  const conversation = document.getElementById('conversation') as HTMLDivElement;

  function addUserMsg(text: string): HTMLElement {
    const tpl = (document.getElementById('tpl-user-msg') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
    const el = tpl.querySelector('.msg') as HTMLElement;
    el.textContent = text;
    conversation.appendChild(el);
    requestAnimationFrame(() => el.classList.add('visible'));
    return el;
  }

  function addAgentMsg(text: string): HTMLElement {
    const tpl = (document.getElementById('tpl-agent-msg') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
    const el = tpl.querySelector('.msg') as HTMLElement;
    const textEl = el.querySelector('.agent-text') as HTMLElement;
    textEl.textContent = text;
    conversation.appendChild(el);
    requestAnimationFrame(() => el.classList.add('visible'));
    return el;
  }

  function showTyping(): HTMLElement {
    const tpl = (document.getElementById('tpl-typing') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
    const el = tpl.querySelector('.msg') as HTMLElement;
    el.classList.add('visible');
    conversation.appendChild(el);
    return el;
  }

  function showFollowUps(options: string[], onSelect: (text: string) => void) {
    const tpl = (document.getElementById('tpl-follow-up') as HTMLTemplateElement).content.cloneNode(true) as DocumentFragment;
    const el = tpl.querySelector('.msg') as HTMLElement;
    const container = el.querySelector('.follow-up-options') as HTMLElement;

    const letters = ['A', 'B', 'C', 'D'];
    options.forEach((optionText, i) => {
      const btn = document.createElement('button');
      btn.className = 'follow-up-btn';
      btn.type = 'button';

      const indicator = document.createElement('span');
      indicator.className = 'btn-indicator';
      indicator.textContent = letters[i];
      btn.appendChild(indicator);

      const text = document.createElement('span');
      text.className = 'btn-text';
      text.textContent = optionText;
      btn.appendChild(text);

      btn.addEventListener('click', () => {
        el.remove();
        onSelect(optionText);
      });
      container.appendChild(btn);
    });

    conversation.appendChild(el);
    requestAnimationFrame(() => el.classList.add('visible'));
    return el;
  }

  function showCloser(intro: string, steps: CloserStep[], outro: string) {
    const el = document.createElement('div');
    el.className = 'msg msg-closer';

    const label = document.createElement('div');
    label.className = 'agent-label';
    label.textContent = 'Agent';
    el.appendChild(label);

    const introEl = document.createElement('div');
    introEl.className = 'closer-intro';
    introEl.textContent = intro;
    el.appendChild(introEl);

    const stepsContainer = document.createElement('div');
    stepsContainer.className = 'closer-steps';

    steps.forEach((step) => {
      const stepEl = document.createElement('div');
      stepEl.className = 'closer-step';

      if (step.tool) {
        const iconWrap = document.createElement('div');
        iconWrap.className = 'closer-step-icon';
        const img = document.createElement('img');
        img.src = step.tool.icon;
        img.alt = step.tool.name;
        img.width = 18;
        img.height = 18;
        iconWrap.appendChild(img);
        stepEl.appendChild(iconWrap);

        const body = document.createElement('div');
        body.className = 'closer-step-body';
        const toolLabel = document.createElement('div');
        toolLabel.className = 'closer-step-tool';
        toolLabel.textContent = step.tool.name;
        body.appendChild(toolLabel);
        const textEl = document.createElement('div');
        textEl.className = 'closer-step-text';
        textEl.textContent = step.text;
        body.appendChild(textEl);
        stepEl.appendChild(body);
      } else {
        const textEl = document.createElement('div');
        textEl.className = 'closer-step-text';
        textEl.textContent = step.text;
        stepEl.appendChild(textEl);
      }

      stepsContainer.appendChild(stepEl);
    });

    el.appendChild(stepsContainer);

    const outroEl = document.createElement('div');
    outroEl.className = 'closer-outro';
    outroEl.textContent = outro;
    el.appendChild(outroEl);

    const mcpNote = document.createElement('div');
    mcpNote.className = 'closer-mcp';
    mcpNote.textContent = 'Connected via MCP \u2014 the open protocol that lets agents use your tools.';
    el.appendChild(mcpNote);

    conversation.appendChild(el);
    requestAnimationFrame(() => el.classList.add('visible'));
    return el;
  }

  function runScenario(scenarioId: string, userLabel: string) {
    const data = SCENARIOS[scenarioId];
    if (!data) return;

    addUserMsg(userLabel);

    setTimeout(() => {
      const typing1 = showTyping();
      setTimeout(() => {
        typing1.remove();
        addAgentMsg(data.agentOpener);
        setTimeout(() => {
          showFollowUps(data.followUps, (selectedText) => {
            addUserMsg(selectedText);
            setTimeout(() => {
              const typing2 = showTyping();
              setTimeout(() => {
                typing2.remove();
                showCloser(data.closerIntro, data.closerSteps, data.closerOutro);
                setTimeout(() => {
                  document.dispatchEvent(new CustomEvent('experience:conversation-done'));
                }, 3000);
              }, 3000);
            }, 600);
          });
        }, 800);
      }, 2500);
    }, 600);
  }

  document.addEventListener('experience:submit-hook', ((e: CustomEvent) => {
    runScenario(e.detail.scenario, e.detail.text);
  }) as EventListener);
</script>
