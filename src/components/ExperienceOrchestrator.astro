<div id="experience-container">
  <slot />
</div>
<a id="skip-link" class="skip-link">skip to resources &#8594;</a>

<style>
  #experience-container {
    position: relative;
  }

  .skip-link {
    position: fixed;
    bottom: 24px;
    right: 24px;
    font-size: 12px;
    color: var(--color-text-muted);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--transition-fast);
    z-index: 100;
  }

  .skip-link:hover {
    color: var(--color-text-dim);
  }

  .skip-link.hidden {
    display: none;
  }
</style>

<script>
  const skipLink = document.getElementById('skip-link') as HTMLAnchorElement;

  function transitionPhase(fromId: string, toId: string) {
    const from = document.getElementById(fromId);
    const to = document.getElementById(toId);
    if (!from || !to) return;

    from.classList.remove('active');
    from.classList.add('exit');

    setTimeout(() => {
      from.style.display = 'none';
      to.style.display = 'flex';
      requestAnimationFrame(() => to.classList.add('active'));
    }, 400);
  }

  // Hook -> Live
  document.addEventListener('experience:submit-hook', () => {
    skipLink.classList.add('hidden');
    transitionPhase('phase-hook', 'phase-live');
  });

  // Live -> Reflect: keep conversation visible, show reflection below
  document.addEventListener('experience:conversation-done', () => {
    const reflect = document.getElementById('phase-reflect');
    if (!reflect) return;

    // Show reflection flowing below the conversation
    reflect.style.display = 'flex';

    // Scroll so the last agent message is at the top, reflection visible below
    setTimeout(() => {
      // Find the last msg-tools element (MCP badges) in the conversation
      const toolsMsgs = document.querySelectorAll('.msg-tools');
      const lastTools = toolsMsgs[toolsMsgs.length - 1];
      const scrollTarget = lastTools || reflect;
      scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });

      setTimeout(() => {
        reflect.classList.add('active');
      }, 600);
    }, 100);

    setTimeout(() => {
      document.dispatchEvent(new CustomEvent('experience:start-reflection'));
    }, 800);
  });

  // Reflect -> Resources
  document.addEventListener('experience:explore', () => {
    // Hide both conversation and reflection, show resources
    const live = document.getElementById('phase-live');
    const reflect = document.getElementById('phase-reflect');
    const resources = document.getElementById('phase-resources');

    if (live) {
      live.classList.remove('active');
      live.classList.add('exit');
    }
    if (reflect) {
      reflect.classList.remove('active');
      reflect.classList.add('exit');
    }

    setTimeout(() => {
      if (live) live.style.display = 'none';
      if (reflect) reflect.style.display = 'none';
      if (resources) {
        resources.style.display = 'flex';
        window.scrollTo({ top: 0, behavior: 'instant' });
        requestAnimationFrame(() => resources.classList.add('active'));
      }
    }, 400);
  });

  // Skip directly to resources
  skipLink.addEventListener('click', () => {
    skipLink.classList.add('hidden');
    document.querySelectorAll('.phase').forEach((p) => {
      (p as HTMLElement).classList.remove('active');
      (p as HTMLElement).style.display = 'none';
    });
    const resources = document.getElementById('phase-resources');
    if (resources) {
      resources.style.display = 'flex';
      requestAnimationFrame(() => resources.classList.add('active'));
    }
  });
</script>