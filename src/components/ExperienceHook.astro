<section id="phase-hook" class="phase active" data-phase="hook">
  <h1>You're about to work with an agent.<br><span class="bold">Let's do something real.</span></h1>
  <p class="subtext">Pick a job you'd hand to an agent.</p>
  <div class="options">
    <button class="option-card" data-scenario="standup" type="button">
      <span class="option-icon">🔄</span>
      <span class="option-text">Run my team's weekly standup</span>
    </button>
    <button class="option-card" data-scenario="website" type="button">
      <span class="option-icon">🌐</span>
      <span class="option-text">Keep my website updated and running</span>
    </button>
    <button class="option-card" data-scenario="questions" type="button">
      <span class="option-icon">💬</span>
      <span class="option-text">Handle incoming questions about my program</span>
    </button>
    <button class="option-card" data-scenario="market" type="button">
      <span class="option-icon">📡</span>
      <span class="option-text">Monitor my market and tell me what matters</span>
    </button>
  </div>
</section>

<style>
  .phase {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 40px 24px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }

  .phase.active {
    opacity: 1;
    transform: translateY(0);
  }

  .phase.exit {
    opacity: 0;
    transform: translateY(-30px);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  h1 {
    font: var(--font-hero);
    letter-spacing: -0.5px;
    text-align: center;
    max-width: 500px;
  }

  .bold {
    font-weight: 600;
  }

  .subtext {
    font-size: 15px;
    color: var(--color-text-dim);
    text-align: center;
    max-width: 400px;
  }

  .options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 560px;
    width: 100%;
  }

  .option-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.4;
    text-align: left;
    transition: all var(--transition-normal);
    cursor: pointer;
  }

  .option-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .option-icon {
    font-size: 24px;
    flex-shrink: 0;
  }

  .option-text {
    font-weight: 500;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 24px;
    }
    .subtext {
      font-size: 14px;
    }
    .options {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const optionCards = document.querySelectorAll('.option-card');

  optionCards.forEach((card) => {
    card.addEventListener('click', () => {
      const scenario = (card as HTMLElement).dataset.scenario;
      const text = card.querySelector('.option-text')?.textContent || '';
      document.dispatchEvent(new CustomEvent('experience:submit-hook', {
        detail: { scenario, text }
      }));
    });
  });
</script>
