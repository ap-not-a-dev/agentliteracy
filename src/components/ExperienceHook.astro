<section id="phase-hook" class="phase active" data-phase="hook">
  <h1>You're about to work with an agent.<br><span class="bold">Let's do something real.</span></h1>
  <p class="subtext">What's something you're working on right now? A project, a problem, a decision you're stuck on.</p>
  <div class="input-area">
    <textarea id="hook-input" placeholder="I'm working on..." rows="1"></textarea>
    <button class="submit-btn" id="hook-submit" type="button">Let's go</button>
  </div>
</section>

<style>
  .phase {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 40px 24px;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }

  .phase.active {
    opacity: 1;
    transform: translateY(0);
  }

  .phase.exit {
    opacity: 0;
    transform: translateY(-30px);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  h1 {
    font: var(--font-hero);
    letter-spacing: -0.5px;
    text-align: center;
    max-width: 500px;
  }

  .bold {
    font-weight: 600;
  }

  .subtext {
    font-size: 15px;
    color: var(--color-text-dim);
    text-align: center;
    max-width: 400px;
  }

  .input-area {
    width: 100%;
    max-width: 520px;
    position: relative;
  }

  textarea {
    width: 100%;
    background: var(--color-input-bg);
    border: 1px solid var(--color-input-border);
    border-radius: 12px;
    padding: 18px 20px;
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.6;
    resize: none;
    height: 64px;
    transition: all var(--transition-normal);
    outline: none;
  }

  textarea:focus {
    border-color: var(--color-input-focus-border);
    background: var(--color-input-focus-bg);
    height: 100px;
  }

  textarea::placeholder {
    color: var(--color-text-muted);
  }

  .submit-btn {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    transform: translateY(4px);
    transition: all var(--transition-normal);
  }

  .submit-btn.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .submit-btn:hover {
    background: #e2e8f0;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 24px;
    }
    .subtext {
      font-size: 14px;
    }
  }
</style>

<script>
  const hookInput = document.getElementById('hook-input') as HTMLTextAreaElement;
  const hookSubmit = document.getElementById('hook-submit') as HTMLButtonElement;

  hookInput.addEventListener('input', () => {
    if (hookInput.value.trim().length > 5) {
      hookSubmit.classList.add('visible');
    } else {
      hookSubmit.classList.remove('visible');
    }
  });

  hookSubmit.addEventListener('click', () => {
    const text = hookInput.value.trim();
    if (!text) return;
    document.dispatchEvent(new CustomEvent('experience:submit-hook', { detail: { text } }));
  });
</script>
